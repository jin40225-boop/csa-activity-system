<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ActivitySystem</AssemblyName>
    <RootNamespace>ActivitySystem.App</RootNamespace>
    <Version>0.1.0</Version>
    <!-- 發行時以 -p:SourceRevisionId=<git short hash> 帶入，視窗標題與畫面頂列會顯示版本 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivitySystem.Core\ActivitySystem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\範本\**\*.*" LinkBase="範本預設">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="config.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
